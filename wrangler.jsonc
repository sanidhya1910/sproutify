{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sproutify",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "66e14d556e6f43d0ae7dbe3a0603e43d"
    }
  ],
  "observability": {
    "enabled": true
  }
}
