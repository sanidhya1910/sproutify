# This project has a pre-existing peer conflict: @opennextjs/cloudflare@1.20.2
# wants next >= 15.5.21, while the project is pinned to next@15.5.3. The build
# and Cloudflare deploy both work fine, so this is accepted rather than forced.
#
# Without this, every `npm i` — including the ones shadcn shells out to when
# adding a component — fails with ERESOLVE.
legacy-peer-deps=true
