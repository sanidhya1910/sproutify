// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(VOLUNTEER)
  ecoTokens Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Volunteer relations
  eventRegistrations EventRegistration[]
  attendances        Attendance[]
  redemptions        Redemption[]

  // Admin relations
  createdEvents      Event[] @relation("EventCreator")

  @@map("users")
}

model Event {
  id               String   @id @default(cuid())
  title            String
  description      String
  location         String
  date             DateTime
  startTime        String
  endTime          String
  // Added in Phase 2. The UI has filtered and colour-coded by `type` since
  // before this column existed, which meant the volunteer events type filter
  // always matched nothing and every event fell back to a generic label.
  type             EventType @default(OTHER)
  expectedVolunteers Int?
  safetyInstructions String?
  isFeatured       Boolean  @default(false)
  imageUrl         String?
  qrCode           String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  creator          User     @relation("EventCreator", fields: [creatorId], references: [id])
  creatorId        String
  registrations    EventRegistration[]
  attendances      Attendance[]

  @@map("events")
}

model EventRegistration {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  
  // Relations
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String

  @@unique([userId, eventId])
  @@map("event_registrations")
}

model Attendance {
  id        String   @id @default(cuid())
  checkedInAt DateTime @default(now())
  
  // Relations
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String

  @@unique([userId, eventId])
  @@map("attendances")
}

model Reward {
  id          String       @id @default(cuid())
  name        String
  description String?
  cost        Int
  imageUrl    String?
  isActive    Boolean      @default(true)
  stock       Int? // null = unlimited
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  redemptions Redemption[]

  @@map("rewards")
}

model Redemption {
  id          String           @id @default(cuid())
  status      RedemptionStatus @default(PENDING)
  tokensSpent Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user     User   @relation(fields: [userId], references: [id])
  userId   String
  reward   Reward @relation(fields: [rewardId], references: [id])
  rewardId String

  @@map("redemptions")
}

enum RedemptionStatus {
  PENDING
  FULFILLED
  CANCELLED
}

enum Role {
  ADMIN
  VOLUNTEER
}
enum EventType {
  CLEANUP
  PLANTATION
  EWASTE
  RESTORATION
  COMMUNITY
  OTHER
}

/// Submissions from the public /contact form. Before Phase 2 that form's
/// submit handler was a 2-second setTimeout that discarded the message
/// entirely while showing a success confirmation.
model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  phone     String?
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}

enum ContactStatus {
  NEW
  READ
  ARCHIVED
}
